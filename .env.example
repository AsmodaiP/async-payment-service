ENVIRONMENT=development
API_KEY=local-development-key
# Swagger UI (/docs, /openapi.json) without X-API-Key; set false to protect them too.
PUBLIC_DOCS=true
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments
RABBITMQ_URL=amqp://payments:payments@rabbitmq:5672/

LOG_LEVEL=INFO
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=30
RABBIT_PUBLISH_TIMEOUT_SECONDS=10
DATABASE_READINESS_TIMEOUT_SECONDS=1.5

PAYMENT_MIN_DELAY_SECONDS=2.0
PAYMENT_MAX_DELAY_SECONDS=5.0
PAYMENT_SUCCESS_RATE=0.9

MAX_DELIVERY_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=2
WEBHOOK_TIMEOUT_SECONDS=5.0
WEBHOOK_LEASE_SECONDS=30
WEBHOOK_BUSY_RETRY_DELAY_SECONDS=1.0
REQUIRE_HTTPS_WEBHOOKS=true
ALLOW_PRIVATE_WEBHOOKS=false
# HMAC-SHA256 secret for X-Webhook-Signature; required (>= 32 chars) in production.
WEBHOOK_SIGNING_SECRET=local-webhook-signing-secret-change-me
